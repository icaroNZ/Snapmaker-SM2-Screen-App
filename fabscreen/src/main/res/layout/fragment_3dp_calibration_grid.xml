<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/default_theme_background"
    android:clickable="true"
    android:focusable="true">

    <include layout="@layout/widget_top_bar" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rl_3dp_calibration_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/margin_layout_10"
        android:layout_marginBottom="@dimen/margin_layout_10"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toTopOf="@id/fl_3dp_calibration_grid_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_bar">

        <TextView
            android:id="@+id/tv_set_calibration_grid_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:text="@string/settings_3dp_calibration_points"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h3"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_set_calibration_grid_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/all_0"
            android:textColor="@color/default_theme_desc1"
            android:textSize="@dimen/font_size_h1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_set_calibration_grid_title" />

        <!-- 3x3..11x11 (firmware GRID_MAX_NUM 11); was a 3/4/5 segmented group -->
        <LinearLayout
            android:id="@+id/ll_calibration_grid_stepper"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/margin_layout_40"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_set_calibration_grid_value">

            <Button
                android:id="@+id/btn_3dp_calibration_grid_minus"
                style="@style/LevelingOptionStepButton"
                android:layout_width="@dimen/height_button_64"
                android:layout_height="@dimen/height_button_45"
                android:text="@string/settings_3dp_calibration_grid_minus" />

            <Button
                android:id="@+id/btn_3dp_calibration_grid_plus"
                style="@style/LevelingOptionStepButton"
                android:layout_width="@dimen/height_button_64"
                android:layout_height="@dimen/height_button_45"
                android:layout_marginStart="@dimen/margin_layout_40"
                android:text="@string/settings_3dp_calibration_grid_plus" />
        </LinearLayout>

        <ImageView
            android:id="@+id/iv_calibration_grid"
            android:layout_width="280dp"
            android:layout_height="280dp"
            android:layout_marginTop="@dimen/margin_layout_10"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ll_calibration_grid_stepper" />

    </androidx.constraintlayout.widget.ConstraintLayout>

    <FrameLayout
        android:id="@+id/fl_3dp_calibration_grid_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/margin_layout_5"
        android:background="@color/default_theme_primary"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <Button
            android:id="@+id/btn_3dp_calibration_grid_save"
            style="@style/AppTheme.Button.BlueButton"
            android:layout_width="match_parent"
            android:layout_height="@dimen/height_button_45"
            android:layout_marginStart="@dimen/margin_layout_20"
            android:layout_marginTop="@dimen/margin_layout_10"
            android:layout_marginEnd="@dimen/margin_layout_20"
            android:layout_marginBottom="@dimen/margin_layout_10"
            android:text="@string/all_save" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>